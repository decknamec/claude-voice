#!/usr/bin/env bash
# Freisprech-Loop für Claude Code: Mikro -> whisper.cpp (lokal) -> claude -p -> say.
#
#   claude-voice              neue Session im aktuellen Verzeichnis
#   claude-voice --last       letzte Voice-Session fortsetzen
#   claude-voice --yolo       Tools ohne Rückfrage erlauben (bypassPermissions)
#   claude-voice --tts piper  Sprachausgabe erzwingen: piper|elevenlabs|say|auto
#
# Aufhören: "stopp" / "ende" sagen, oder Ctrl-C.
set -uo pipefail

MODEL="$HOME/.claude/whisper-models/ggml-large-v3-turbo-q5_0.bin"
WHISPER_LANG=de
VOICE=Anna
RATE=190
MAX_CHARS=900          # längere Antworten als beim Hook — hier ist Vorlesen der Zweck
SILENCE_SEC=1.6        # so lange Stille beendet die Aufnahme
SILENCE_THRESH=2%      # Pegel, ab dem es als Sprache zählt
MAX_REC=90             # harte Obergrenze pro Aufnahme (Sekunden)
MIN_DUR=0.4            # kürzere Aufnahmen sind Husten, kein Satz
PERMISSION_MODE=acceptEdits
CLAUDE_MODEL=""          # leer = dein Default (opus[1m]). Für spürbar weniger
                         # Wartezeit: CLAUDE_MODEL=claude-sonnet-5
# Ohne das antwortet Claude in Markdown mit Codeblöcken — die filtert speakable_text
# zwar raus, aber übrig bleibt Stückwerk. Besser gleich sprechbar antworten lassen.
VOICE_SYSTEM_PROMPT="Deine Antwort wird per Sprachausgabe vorgelesen. Antworte auf Deutsch, in höchstens drei bis vier Sätzen, in ganzen Sätzen ohne Markdown, ohne Codeblöcke, ohne Aufzählungen. Lies keine Dateipfade oder URLs vor, beschreibe sie stattdessen. Wenn die Antwort zwingend Code braucht, sag nur, was du geändert hast und wo."
# Whisper auf Fachvokabular vorspannen — ohne das wird aus "Stop Hook" gern
# "Stopthook". In ~/.claude/voice-loop.conf überschreibbar.
VOCAB="Claude Code, Hook, Repo, Commit, Branch, Pull Request, Merge, Supabase, Vercel, TypeScript, Deploy, Terminal, Debugging, Refactoring, Prompt, Skill, Subagent, Transcript."
# shellcheck disable=SC1090
[ -f "$HOME/.claude/voice.conf" ] && source "$HOME/.claude/voice.conf"
[ -f "$HOME/.claude/voice-loop.conf" ] && source "$HOME/.claude/voice-loop.conf"

source "$HOME/.claude/hooks/lib/speakable.sh"
source "$HOME/.claude/hooks/lib/voicelock.sh"
source "$HOME/.claude/hooks/lib/elkey.sh"

# Einmal auflösen und vererben: sonst zahlt jeder gesprochene Satz den
# 1Password-Zugriff erneut.
el_resolve_key && export ELEVENLABS_API_KEY

SESSION_FILE="$HOME/.claude/voice-loop-session"
WORK=$(mktemp -d)
WAV="$WORK/in.wav"

# while statt for: --tts nimmt ein Argument, und in `for a in "$@"` wäre
# ein shift wirkungslos.
resume=false
while [ $# -gt 0 ]; do
  case "$1" in
    --last) resume=true; shift ;;
    --yolo) PERMISSION_MODE=bypassPermissions; shift ;;
    --tts)  export TTS_BACKEND="${2:-auto}"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unbekannt: $1" >&2; exit 1 ;;
  esac
done

[ -f "$MODEL" ] || { echo "Modell fehlt: $MODEL" >&2; exit 1; }

cleanup() {
  pkill -x say 2>/dev/null
  [ -n "${LOOP_PID:-}" ] && kill "$LOOP_PID" 2>/dev/null
  exec 3>&- 2>/dev/null; exec 4<&- 2>/dev/null
  voicelock_release; rm -rf "$WORK"; echo; echo "Tschüss."
}
trap cleanup EXIT INT TERM
voicelock_acquire   # sagt speak-answer.sh: Finger weg, ich spreche selbst

SID=""
if $resume && [ -s "$SESSION_FILE" ]; then SID=$(cat "$SESSION_FILE"); fi

speak() { "$HOME/.claude/bin/claude-say" "$1"; }

# Nichts Verwertbares aufgenommen. Kurz bremsen; kommt das am Stück zu oft vor,
# ist das Mikro stumm oder belegt — dann aussteigen statt ewig weiterdrehen.
too_quiet() {
  idle=$((idle + 1))
  if [ "$idle" -ge 25 ]; then
    echo
    echo "25x nichts gehört — Mikro stumm oder von einer anderen App belegt?"
    echo "Prüfen: Systemeinstellungen > Datenschutz > Mikrofon, und ob FluidVoice/Voicely gerade lauschen."
    exit 1
  fi
  sleep 0.2
}

# Eine Session, die offen bleibt. Vorher startete jede Aeusserung ein eigenes
# `claude -p`; allein der Prozessstart kostete gemessen rund 13 Sekunden.
LOOP="$HOME/.claude/voice-ui/agent-loop.mjs"
[ -f "$LOOP" ] || LOOP="$(cd "$(dirname "$0")/.." && pwd)/ui/agent-loop.mjs"
[ -f "$LOOP" ] || { echo "agent-loop.mjs fehlt: $LOOP" >&2; exit 1; }

FIFO_IN="$WORK/in"; FIFO_OUT="$WORK/out"
mkfifo "$FIFO_IN" "$FIFO_OUT"
LOOP_ARGS=(--cwd "$PWD" --permission-mode "$PERMISSION_MODE" --system-prompt "$VOICE_SYSTEM_PROMPT")
[ -n "$CLAUDE_MODEL" ] && LOOP_ARGS+=(--model "$CLAUDE_MODEL")
$resume && [ -n "$SID" ] && LOOP_ARGS+=(--resume "$SID")
node "$LOOP" "${LOOP_ARGS[@]}" < "$FIFO_IN" > "$FIFO_OUT" 2>"$WORK/err" &
LOOP_PID=$!
# Beide Enden offen halten: sonst sieht node ein EOF, sobald der erste
# Schreiber fertig ist, und beendet sich mitten in der Sitzung.
exec 3> "$FIFO_IN"
exec 4< "$FIFO_OUT"

# Eine Zeile JSON hineinschicken. jq baut sie, damit Anfuehrungszeichen und
# Zeilenumbrueche im Gesagten nichts zerreissen.
sende() { jq -cn --arg t "$1" '{typ:"sagen",text:$t}' >&3; }

# Antwort einlesen, bis der Zug fertig ist. Saetze werden gesprochen, sobald
# sie ankommen — das ist der zweite Teil des Zeitgewinns.
antwort_lesen() {
  local zeile typ text name arg fid
  while IFS= read -r zeile <&4; do
    [ -n "$zeile" ] || continue
    typ=$(printf '%s' "$zeile" | jq -r '.typ // ""')
    case "$typ" in
      satz)
        text=$(printf '%s' "$zeile" | jq -r '.text')
        printf '\033[1mClaude:\033[0m %s\n' "$text"
        spoken=$(printf '%s' "$text" | speakable_text)
        [ -n "$spoken" ] && speak "$(clip_to_sentence "$spoken" "$MAX_CHARS")"
        ;;
      werkzeug)
        name=$(printf '%s' "$zeile" | jq -r '.name')
        arg=$(printf '%s' "$zeile" | jq -r '.arg')
        printf '\033[2m  %s %s\033[0m\n' "$name" "$arg"
        ;;
      freigabe)
        fid=$(printf '%s' "$zeile" | jq -r '.id')
        name=$(printf '%s' "$zeile" | jq -r '.werkzeug')
        arg=$(printf '%s' "$zeile" | jq -r '.arg')
        printf '\033[33m  Freigabe:\033[0m %s %s  [j/n] ' "$name" "$arg"
        speak "Freigabe für $name?"
        # Vom Terminal lesen, nicht von der Pipe.
        if read -r -n 1 taste < /dev/tty 2>/dev/null; then :; else taste=n; fi
        echo
        case "$taste" in
          j|J|y|Y|'') jq -cn --arg i "$fid" '{typ:"freigabe",id:$i,ok:true}' >&3 ;;
          *)          jq -cn --arg i "$fid" '{typ:"freigabe",id:$i,ok:false}' >&3 ;;
        esac
        ;;
      session)
        SID=$(printf '%s' "$zeile" | jq -r '.id')
        printf '%s' "$SID" > "$SESSION_FILE"
        ;;
      fehler)
        text=$(printf '%s' "$zeile" | jq -r '.text')
        printf '\033[31mFehler:\033[0m %s\n' "$text"
        speak "Da ist etwas schiefgegangen."
        return 1
        ;;
      fertig) return 0 ;;
    esac
  done
  return 1
}

printf '\n\033[1mclaude-voice\033[0m  %s | %s | %s | Stimme: %s\n' \
  "$(basename "$PWD")" "$PERMISSION_MODE" \
  "$([ -n "$SID" ] && echo "resume ${SID:0:8}" || echo 'neue Session')" \
  "$("$HOME/.claude/bin/claude-say" --backends | awk '/aktiv:/{print $2}')"
echo 'Sprich einfach los. Aufnahme stoppt nach kurzer Stille. "stopp" beendet.'

idle=0
while true; do
  printf '\n\033[2m…hört zu\033[0m\r'
  # Startet bei Sprache, stoppt nach SILENCE_SEC Stille. `|| true`, weil rec bei
  # Timeout/Signal nonzero liefert, die Aufnahme aber trotzdem brauchbar ist.
  rec -q -c 1 -r 16000 -b 16 -e signed-integer "$WAV" \
      silence 1 0.2 "$SILENCE_THRESH" 1 "$SILENCE_SEC" "$SILENCE_THRESH" \
      trim 0 "$MAX_REC" 2>/dev/null </dev/null || true
  [ -s "$WAV" ] || { too_quiet; continue; }

  dur=$(soxi -D "$WAV" 2>/dev/null || echo 0)
  awk -v d="$dur" -v m="$MIN_DUR" 'BEGIN{exit !(d < m)}' && { too_quiet; continue; }

  printf '\033[2m…verstehe   \033[0m\r'
  said=$(whisper-cli -m "$MODEL" -l "$WHISPER_LANG" -nt -np -t 8 \
           --prompt "$VOCAB" --carry-initial-prompt -f "$WAV" 2>/dev/null \
         | tr '\n' ' ' | sed 's/^ *//; s/ *$//')

  # Whisper halluziniert auf Stille gern Standardphrasen — die wegwerfen.
  lower=$(printf '%s' "$said" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    ''|'.'|'[blank_audio]'*|'(musik)'*|'untertitel'*|'vielen dank.'|'vielen dank!'|*amara.org*) too_quiet; continue ;;
  esac
  [ "${#said}" -lt 3 ] && { too_quiet; continue; }

  case "$lower" in
    stopp*|stop*|ende|ende.|beenden*|schluss*|tschüss*|'auf wiedersehen'*|exit*)
      speak "Alles klar, bis später."; exit 0 ;;
  esac

  idle=0
  printf '\033[1mDu:\033[0m %s\n' "$said"
  printf '\033[2m…denkt      \033[0m\r'

  sende "$said"
  antwort_lesen || true
  sleep 0.4   # verhindert, dass das Mikro das Ende der eigenen Stimme aufnimmt
done
