#!/usr/bin/env bash
# Speech output for every voice path (hook, CLI loop, UI). Blocks until done.
#
#   claude-say "Text"
#   claude-say --tts piper "Text"   force a backend for this call
#   claude-say --backends           show what is available and active
#   claude-say --doctor             check the configuration
#   claude-say --list               ElevenLabs voices and models
#   claude-say --find-op            find the 1Password reference for the key
#
# Backends (TTS_BACKEND in the config, or --tts):
#   auto         ElevenLabs if a key is present, otherwise edge, piper, say
#   elevenlabs   best quality, costs credits, needs the network (~1.1 s)
#   edge         Microsoft neural voices, free, no key (~0.5 s).
#                NOT local: it goes through an undocumented endpoint.
#   piper        local and offline (~0.7 s), audibly more synthetic
#   say          macOS system voice, instant, most brittle quality
#
# A failing backend always falls back to `say`: silence is the worst answer
# while someone is waiting to be spoken to.
#
# ElevenLabs key, in this order: $ELEVENLABS_API_KEY, ~/.claude/voice.env,
# 1Password (EL_KEY_OP_REF), macOS keychain.
set -uo pipefail

# Precedence: --tts > inherited environment > config file > default. The
# environment has to be cached, because the assignment below would overwrite it
# and the loop or the UI could not pass their choice through.
_TTS_FROM_ENV="${TTS_BACKEND:-}"
TTS_BACKEND=auto
VOICE=Anna; RATE=190

PIPER_MODEL="$HOME/.claude/piper-voices/de_DE-thorsten-medium.onnx"
PIPER_BIN=""                      # leer = automatisch suchen

EDGE_VOICE=de-DE-SeraphinaMultilingualNeural
EDGE_BIN=""

EL_VOICE_ID=""                    # leer = erste Stimme des Accounts (siehe --list)
EL_MODEL=eleven_turbo_v2_5
EL_STABILITY=0.45
EL_SIMILARITY=0.75
EL_SPEED=""
EL_FORMAT=mp3_44100_128
EL_KEY_OP_REF=""
EL_KEY_OP_ACCOUNT=""
# shellcheck disable=SC1090
[ -f "$HOME/.claude/voice.conf" ] && source "$HOME/.claude/voice.conf"
[ -f "$HOME/.claude/voice-loop.conf" ] && source "$HOME/.claude/voice-loop.conf"
source "$HOME/.claude/hooks/lib/elkey.sh"
[ -n "$_TTS_FROM_ENV" ] && TTS_BACKEND="$_TTS_FROM_ENV"

# Read --tts and --voice before anything else so they override the config.
_VOICE_OVERRIDE=""
OUT=""            # gesetzt -> schreiben statt abspielen
while true; do
  case "${1:-}" in
    --tts)   TTS_BACKEND="${2:-auto}"; shift 2 ;;
    --voice) _VOICE_OVERRIDE="${2:-}"; shift 2 ;;
    --out)   OUT="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
if [ -n "$_VOICE_OVERRIDE" ]; then
  case "$TTS_BACKEND" in
    piper)      PIPER_MODEL="$HOME/.claude/piper-voices/$_VOICE_OVERRIDE.onnx" ;;
    edge)       EDGE_VOICE="$_VOICE_OVERRIDE" ;;
    elevenlabs) EL_VOICE_ID="$_VOICE_OVERRIDE" ;;
    say|*)      VOICE="$_VOICE_OVERRIDE" ;;
  esac
fi

api_key() { el_resolve_key || return 1; printf '%s' "$ELEVENLABS_API_KEY"; }

# ── Backends ─────────────────────────────────────────────────────────
piper_bin() {
  [ -n "$PIPER_BIN" ] && { printf '%s' "$PIPER_BIN"; return 0; }
  command -v piper 2>/dev/null && return 0
  # uv tool install puts it here, and the hook often does not inherit this PATH.
  [ -x "$HOME/.local/bin/piper" ] && { printf '%s' "$HOME/.local/bin/piper"; return 0; }
  return 1
}
piper_ready() { [ -f "$PIPER_MODEL" ] && piper_bin >/dev/null; }

edge_bin() {
  [ -n "$EDGE_BIN" ] && { printf '%s' "$EDGE_BIN"; return 0; }
  command -v edge-tts 2>/dev/null && return 0
  [ -x "$HOME/.local/bin/edge-tts" ] && { printf '%s' "$HOME/.local/bin/edge-tts"; return 0; }
  return 1
}
edge_ready() { edge_bin >/dev/null; }

# The only place where audio leaves the machine, or goes into a file instead.
emit() {  # $1 = erzeugte Datei
  if [ -n "$OUT" ]; then mv "$1" "$OUT"; else afplay "$1"; rm -f "$1"; fi
}

speak_say() {
  if [ -n "$OUT" ]; then
    # 16-bit WAV: `say` produces it directly and browsers play it.
    say -v "$VOICE" -r "$RATE" -o "$OUT" --data-format=LEI16@22050 --file-format=WAVE -- "$1"
  else
    say -v "$VOICE" -r "$RATE" -- "$1"
  fi
}

speak_piper() {
  local bin dir tmp rc
  bin=$(piper_bin) || return 1
  [ -f "$PIPER_MODEL" ] || return 1
  dir=$(mktemp -d -t claudesay); tmp="$dir/a.wav"
  printf '%s' "$1" | "$bin" -m "$PIPER_MODEL" -f "$tmp" >/dev/null 2>&1
  [ -s "$tmp" ] || { rm -rf "$dir"; return 1; }
  emit "$tmp"; rc=$?; rm -rf "$dir"; return $rc
}

speak_edge() {
  local bin dir tmp rc
  bin=$(edge_bin) || return 1
  dir=$(mktemp -d -t claudesay); tmp="$dir/a.mp3"
  "$bin" --voice "$EDGE_VOICE" --text "$1" --write-media "$tmp" >/dev/null 2>&1
  [ -s "$tmp" ] || { rm -rf "$dir"; return 1; }
  emit "$tmp"; rc=$?; rm -rf "$dir"; return $rc
}

el_get() {  # $1 = Pfad
  local key; key=$(api_key) || return 1
  curl -sS --max-time 15 -H "xi-api-key: $key" "https://api.elevenlabs.io/v1/$1"
}

speak_elevenlabs() {
  local key body dir tmp code rc
  key=$(api_key) || return 1

  # With no voice configured, take the account's first one and remember it, so
  # the lookup does not go over the wire again for every sentence.
  local cache="$HOME/.claude/.elevenlabs-voice"
  [ -z "$EL_VOICE_ID" ] && [ -s "$cache" ] && EL_VOICE_ID=$(cat "$cache")
  if [ -z "$EL_VOICE_ID" ]; then
    EL_VOICE_ID=$(el_get voices | jq -r '.voices[0].voice_id // empty' 2>/dev/null)
    [ -n "$EL_VOICE_ID" ] && printf '%s' "$EL_VOICE_ID" > "$cache"
  fi
  [ -n "$EL_VOICE_ID" ] || return 1

  body=$(jq -nc --arg t "$1" --arg m "$EL_MODEL" \
                --argjson st "$EL_STABILITY" --argjson sb "$EL_SIMILARITY" \
                '{text:$t, model_id:$m, voice_settings:{stability:$st, similarity_boost:$sb}}')
  [ -n "$EL_SPEED" ] && body=$(printf '%s' "$body" | jq -c --argjson sp "$EL_SPEED" '.voice_settings.speed = $sp')

  dir=$(mktemp -d -t claudesay); tmp="$dir/a.mp3"
  code=$(curl -sS --max-time 45 -o "$tmp" -w '%{http_code}' \
    -X POST "https://api.elevenlabs.io/v1/text-to-speech/${EL_VOICE_ID}?output_format=${EL_FORMAT}" \
    -H "xi-api-key: $key" -H 'content-type: application/json' \
    --data-binary "$body" 2>/dev/null)
  if [ "$code" != 200 ] || [ ! -s "$tmp" ]; then
    echo "claude-say: ElevenLabs HTTP $code" >&2
    head -c 300 "$tmp" >&2 2>/dev/null; echo >&2
    rm -rf "$dir"; return 1
  fi
  emit "$tmp"; rc=$?; rm -rf "$dir"; return $rc
}

# ── Subcommands ──────────────────────────────────────────────────────
case "${1:-}" in
  --backends-json)
    # Machine readable for the UI: what is available, why not, which voices.
    # One source of truth, so the UI never has to parse text output.
    el_ok=false; el_detail="kein Key hinterlegt"
    if el_resolve_key; then el_ok=true; el_detail="Key über $EL_KEY_SOURCE"; fi
    p_ok=false; p_detail="piper oder Stimmmodell fehlt"
    if piper_ready; then p_ok=true; p_detail="$(basename "$(piper_bin)")"; fi
    e_ok=false; e_detail="edge-tts nicht installiert"
    if edge_ready; then e_ok=true; e_detail="Microsoft Neural, ohne Key"; fi

    say_voices=$(say -v '?' 2>/dev/null | grep de_DE | sed 's/ *de_DE.*//' | sed 's/ *$//')
    piper_voices=$(ls "$HOME/.claude/piper-voices"/*.onnx 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.onnx$//')
    edge_voices=""; $e_ok && edge_voices=$("$(edge_bin)" --list-voices 2>/dev/null | awk '/^de-/{print $1}')
    el_voices=""
    if $el_ok; then
      el_voices=$(el_get voices 2>/dev/null | jq -r '.voices[]? | [.voice_id, .name] | @tsv' 2>/dev/null)
    fi

    jq -nc \
      --arg active "$TTS_BACKEND" \
      --argjson elok "$el_ok" --arg eld "$el_detail" --arg defl "$EL_VOICE_ID" \
      --argjson pok "$p_ok"  --arg pd  "$p_detail" --arg defp "$(basename "$PIPER_MODEL" .onnx)" \
      --argjson eok "$e_ok"  --arg ed  "$e_detail" --arg defe "$EDGE_VOICE" \
      --arg defs "$VOICE" \
      --arg sv "$say_voices" --arg pv "$piper_voices" --arg ev "$edge_voices" --arg lv "$el_voices" '
        def plain: if . == "" then [] else [splits("
") | select(length > 0) | {id: ., name: .}] end;
        def pairs: if . == "" then [] else [splits("
") | select(length > 0)
                     | split("	") | {id: .[0], name: (.[1] // .[0])}] end;
        { active: $active, backends: [
          { id:"auto",       label:"Automatisch",      available:true,  detail:"bestes verfügbares", voices:[], default:"" },
          { id:"elevenlabs", label:"ElevenLabs",       available:$elok, detail:$eld, voices:($lv|pairs), default:$defl, network:true, cost:true },
          { id:"edge",       label:"Edge (Microsoft)", available:$eok,  detail:$ed,  voices:($ev|plain), default:$defe, network:true },
          { id:"piper",      label:"Piper (lokal)",    available:$pok,  detail:$pd,  voices:($pv|plain), default:$defp },
          { id:"say",        label:"System (macOS)",   available:true,  detail:"immer verfügbar", voices:($sv|plain), default:$defs }
        ]}'
    exit 0 ;;
  --backends)
    printf "  %-11s %s\n" "aktiv:" "$TTS_BACKEND"
    printf "  %-11s %s\n" "piper:" "$(piper_ready && echo "bereit ($(basename "$PIPER_MODEL"))" || echo "nicht eingerichtet")"
    printf "  %-11s %s\n" "edge:" "$(edge_ready && echo "bereit ($EDGE_VOICE)" || echo "nicht installiert")"
    printf "  %-11s %s\n" "elevenlabs:" "$(el_resolve_key && echo "Key über $EL_KEY_SOURCE" || echo "kein Key")"
    printf "  %-11s %s\n" "say:" "immer verfügbar ($VOICE)"
    exit 0 ;;
  --list)
    key=$(api_key) || { echo "Kein Key." >&2; exit 1; }
    echo "== Stimmen =="
    el_get voices | jq -r '.voices[] | "  \(.voice_id)  \(.name)"'
    echo "== Modelle =="
    el_get models | jq -r '.[] | select(.can_do_text_to_speech)
      | (29 - (.model_id | length)) as $pad
      | "  \(.model_id)\(if $pad > 0 then " " * $pad else " " end)de=\(
          if ([.languages[]?.language_id] | index("de")) then "ja" else "nein" end)"'
    exit 0 ;;
  --doctor)
    echo "Backend: $TTS_BACKEND"
    echo "Piper:   $(piper_ready && echo "ok - $(piper_bin), $(basename "$PIPER_MODEL")" || echo "nicht eingerichtet")"
    if el_resolve_key; then
      echo "Key:     $EL_KEY_SOURCE (${#ELEVENLABS_API_KEY} Zeichen)"
      code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 \
             -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/user 2>/dev/null)
      echo "API:     HTTP $code $([ "$code" = 200 ] && echo '(ok)' || echo '(Key ungültig?)')"
    else
      echo "Key:     fehlt"
      command -v op >/dev/null 2>&1 && ! op whoami >/dev/null 2>&1 && \
        echo "         (op installiert, aber nicht angemeldet)"
    fi
    exit 0 ;;
  --find-op)
    command -v op >/dev/null 2>&1 || { echo "op fehlt." >&2; exit 1; }
    op item list --format=json 2>/dev/null \
      | jq -r '.[] | select(.title | ascii_downcase | contains("eleven"))
               | [.id, (.vault.name // "?"), .title] | @tsv' \
      | while IFS=$'\t' read -r _id _vault _title; do
          op item get "$_id" --format=json 2>/dev/null \
            | jq -r --arg v "$_vault" --arg t "$_title" \
                '.fields[]? | select(.value != null)
                 | "  EL_KEY_OP_REF=\"op://\($v)/\($t)/\(.label // .id)\""'
        done
    exit 0 ;;
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

TEXT="${1:-}"
[ -n "$TEXT" ] || exit 0

case "$TTS_BACKEND" in
  say)        speak_say "$TEXT" ;;
  piper)      speak_piper "$TEXT" || { echo "claude-say: piper fehlgeschlagen -> say" >&2; speak_say "$TEXT"; } ;;
  edge)       speak_edge "$TEXT"  || { echo "claude-say: edge fehlgeschlagen -> say" >&2; speak_say "$TEXT"; } ;;
  elevenlabs) speak_elevenlabs "$TEXT" || { echo "claude-say: ElevenLabs fehlgeschlagen -> say" >&2; speak_say "$TEXT"; } ;;
  auto|*)
    if el_resolve_key; then
      speak_elevenlabs "$TEXT" && exit 0
      echo "claude-say: ElevenLabs fehlgeschlagen -> nächstes Backend" >&2
    fi
    edge_ready  && speak_edge  "$TEXT" && exit 0
    piper_ready && speak_piper "$TEXT" && exit 0
    speak_say "$TEXT" ;;
esac
